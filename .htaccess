DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Never serve application internals directly. index.php and api.php include
  # these files from disk, but they must not be reachable over HTTP.
  RewriteRule ^app(?:/|$) - [F,L,NC]

  # Rewrite API URLs to api.php. Anchor the match so an admin path that
  # happens to contain "api" is not captured by this rule.
  RewriteRule ^api(/.*)?$ api.php?data=api$1 [QSA,L,NC]

  # Public SEO endpoints
  RewriteRule ^sitemap\.xml$ index.php?action=sitemap [QSA,L]
  RewriteRule ^feed\.xml$ index.php?action=feed [QSA,L]

  # Rewrite all other URLs to index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ index.php?action=$1 [QSA,L]
</IfModule>